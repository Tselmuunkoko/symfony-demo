{% extends 'base.html.twig' %}

{% block title %}Department reports{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-6 flex flex-col gap-5">
        <div class="bg-white shadow-md rounded-lg grid-col-span-1">
        <h3 class="text-xl font-semibold p-4">Department</h3>
        <table class="min-w-full table-auto">
            <thead class="bg-gray-100 text-gray-700 uppercase text-xs">
            <tr>
                <th class="px-4 py-2 text-left">ID</th>
                <th class="px-4 py-2 text-left">Name</th>
                <th class="px-4 py-2 text-left">Actions</th>
                <th class="px-4 py-2 text-left">Delete</th>
            </tr>
            </thead>
            <tbody class="text-gray-800 divide-y divide-gray-200">
            {% for i in departments %}
            <tr data-id={{i.id}} class="cursor-pointer">
                <td class="px-4 py-2">{{i.id}}</td>
                <td class="px-4 py-2">{{i.name}}</td>
                <td class="px-4 py-2">
                    <a href="{{ path('app_department_update', { 'id': i.id }) }}" class="text-blue-600">Edit</a>
                </td>
                <td class="px-4 py-2">
                <a href="{{ path('app_department_delete', { 'id': i.id }) }}" class="text-red-600" onclick="return confirm('Are you sure you want to delete this department?')">Delete</a></td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="m-4">
            <form method="POST" action="{{ path('app_department_create') }}">
                <label for="departmentName" class="block text-sm font-medium text-gray-700 mb-1">New Department Name:</label>
                <input type="text" id="departmentName" name="name" required class="border px-2 py-1">
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Create Department</button>
            </form>
        </div>
    </div>
    <div class="bg-white shadow-md rounded-lg">
        <h3 class="text-xl font-semibold p-4">Department Report</h3>
        <div class="m-4">
        <form method="get" action="{{ path('app_department') }}" class="flex gap-4">
        <div>
            <label for="month" class="block text-sm font-medium text-gray-700 mb-1">Select month</label>
            <input type="month" name="month" id="month" class="border rounded px-3 py-2 text-sm focus:ring focus:ring-blue-200" value="{{ month }}"/>
        </div>
        <button
            id="filterBtn"
            type="submit"
            class="self-end bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700"
        >
            Filter
        </button>
        <button
            id="exportBtn"
            class="self-end bg-green-500 text-white px-4 py-2 rounded hover:bg-green-700">
            Export
        </button>
        </form>
        </div>
        <table class="exporting-table min-w-full bg-white shadow-md overflow-hidden text-sm">
            <thead class="bg-gray-100 text-gray-700 uppercase text-xs">
                <tr>
                    <th class="px-6 py-3 text-left">Department</th>
                    <th class="px-6 py-3 text-right">Current month</th>
                    <th class="px-6 py-3 text-right">Previous month</th>
                    <th class="px-6 py-3 text-right">Change</th>
                </tr>
            </thead>
            <tbody class="text-gray-800 divide-y divide-gray-200">
                {% for sale in sales %}
                    {% set growth = sale.previous != 0 ? ((sale.current - sale.previous) / sale.previous * 100)|round(1) : 0 %}
                    <tr>
                        <td class="px-6 py-4">{{ sale.department_name }}</td>
                        <td class="px-6 py-4 text-right">${{ sale.current|number_format(0, '.', ',') }}</td>
                        <td class="px-6 py-4 text-right">${{ sale.previous|number_format(0, '.', ',') }}</td>
                        <td class="px-6 py-4 text-right">
                            {% if growth > 0 %}
                                <span class="text-green-600 font-semibold">
                                    ▲ {{ growth }}%
                                </span>
                            {% elseif growth < 0 %}
                                <span class="text-red-600 font-semibold">
                                    ▼ {{ growth|abs }}%
                                </span>
                            {% else %}
                                <span class="text-gray-500 font-medium">–</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
    <script>
        document.getElementById('exportBtn').addEventListener('click', function () {
            const table = document.querySelectorAll('.exporting-table')[0];
            const rows = Array.from(table.querySelectorAll('tr'));
            const csv = [];

            rows.forEach(row => {
                const cols = row.querySelectorAll('th, td');
                const rowData = Array.from(cols).map(col => {
                    return `"${col.innerText.trim()}"`;
                });
                csv.push(rowData.join(','));
            });

            const blob = new Blob([csv.join('\n')], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'sales-data.csv';
            a.click();
            window.URL.revokeObjectURL(url);
        });
    </script>
{% endblock %}
